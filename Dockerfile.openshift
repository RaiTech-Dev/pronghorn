# ── Stage 1: Build ─────────────────────────────────────────
FROM oven/bun:1-alpine AS builder
WORKDIR /app
COPY package.json bun.lockb ./
RUN bun install
COPY . .
ARG VITE_SUPABASE_URL
ARG VITE_SUPABASE_ANON_KEY
ARG VITE_SUPABASE_PUBLISHABLE_KEY
ARG VITE_SUPABASE_PROJECT_ID
ARG VITE_ADMIN_KEY
ARG VITE_APP_URL
ENV VITE_SUPABASE_URL=$VITE_SUPABASE_URL
ENV VITE_SUPABASE_ANON_KEY=$VITE_SUPABASE_ANON_KEY
ENV VITE_SUPABASE_PUBLISHABLE_KEY=$VITE_SUPABASE_PUBLISHABLE_KEY
ENV VITE_SUPABASE_PROJECT_ID=$VITE_SUPABASE_PROJECT_ID
ENV VITE_ADMIN_KEY=$VITE_ADMIN_KEY
ENV VITE_APP_URL=$VITE_APP_URL
RUN bun run build

# ── Stage 2: Serve ─────────────────────────────────────────
FROM nginx:1.27-alpine AS runner

# Create nginx user with fixed UID that OpenShift can override
RUN addgroup -g 1001 -S nginx-openshift && \
    adduser -u 1001 -S nginx-openshift -G nginx-openshift

# Set working directory
WORKDIR /app

# Copy built assets
COPY --from=builder /app/dist /app/public

# Copy nginx configuration
COPY nginx.conf /etc/nginx/nginx.conf

# Set permissions for OpenShift arbitrary UIDs
# OpenShift assigns random UIDs in the root group (GID 0)
RUN chgrp -R 0 /app /var/cache/nginx /var/run /var/log/nginx /etc/nginx && \
    chmod -R g=u /app /var/cache/nginx /var/run /var/log/nginx /etc/nginx && \
    chmod g=u /etc/passwd

# Use non-root user
USER 1001

# Expose port 8080 (non-privileged)
EXPOSE 8080

CMD ["nginx", "-g", "daemon off;"]
